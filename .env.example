# ============================================
# JobPilot for Feishu - 环境变量配置
# ============================================

# --- 服务配置 ---
PORT=3000
NODE_ENV=development

# --- 飞书应用凭证 ---
# 在飞书开放平台 (https://open.feishu.cn) 创建应用后获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书事件订阅验证 Token（在"事件订阅"页面获取）
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书事件订阅加密 Key（可选，推荐配置）
FEISHU_ENCRYPT_KEY=

# --- 飞书多维表格配置 ---
# 多维表格 App Token（从表格 URL 中获取）
FEISHU_BITABLE_APP_TOKEN=bascnXXXXXXXXXXXXXX
# 数据表 Table ID（创建数据表后获取）
FEISHU_BITABLE_TABLE_ID=tblXXXXXXXXXXXXXXXX

# --- 飞书文档配置 ---
# 文档存放的文件夹 Token（可选，不填则创建在根目录）
FEISHU_DOC_FOLDER_TOKEN=

# --- 大模型配置 ---
# 支持 OpenAI 兼容接口（OpenAI / 火山方舟 / DeepSeek / 通义千问等）
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# LLM 调用超时（毫秒）
LLM_TIMEOUT=30000
# LLM 最大重试次数
LLM_MAX_RETRIES=2

# --- 日志配置 ---
LOG_LEVEL=info
