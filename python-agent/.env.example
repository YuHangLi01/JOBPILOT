# ============================================================
# JobPilot Agent Python 服务 — 环境变量配置
# cp .env.example .env  然后填入真实值
# ============================================================

# ── 服务配置 ──────────────────────────────────────────────────
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

# ── 大模型（火山方舟 OpenAI 兼容接口） ───────────────────────
LLM_API_BASE_URL=xxxx
LLM_API_KEY=xxxx
LLM_MODEL=xxx
LLM_MODEL_LITE=xxx

# ── Milvus 向量数据库 ─────────────────────────────────────────
MILVUS_URI=http://localhost:19530

# ── PostgreSQL（LangGraph Checkpointer） ─────────────────────
POSTGRES_URL=postgresql://user:password@localhost:5432/jobpilot

# ── Node.js Gateway 内部回调 ──────────────────────────────────
NODEJS_CALLBACK_URL=http://localhost:3000/internal
NODEJS_INTERNAL_SECRET=change-me-in-production

# ── 嵌入模型 ─────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
